# Local development only. bootstrap-env.mjs creates a random local password.
POSTGRES_DB=buildos
POSTGRES_USER=buildos
POSTGRES_PORT=55432
POSTGRES_PASSWORD=replace_with_a_local_password
DATABASE_URL="postgresql://buildos:replace_with_a_local_password@localhost:55432/buildos?schema=public"
# Explicitly enables the stage-1 demo adapter. Disable before external deployment.
DEMO_MODE=true
DEMO_COMPANY_ID=10000000-0000-4000-8000-000000000001
