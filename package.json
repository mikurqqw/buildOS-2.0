{
  "name": "buildos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "env:setup": "node scripts/bootstrap-env.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose stop",
    "db:local": "node --env-file=.env scripts/local-postgres.mjs",
    "db:prepare": "npm run db:generate && npm run db:deploy && npm run db:seed",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:validate": "prisma validate",
    "db:studio": "prisma studio",
    "db:setup": "npm run env:setup && npm run db:up && npm run db:generate && npm run db:deploy && npm run db:seed",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:smoke": "node scripts/smoke-http.mjs",
    "test:auth": "node scripts/auth-smoke.mjs",
    "test:company": "node scripts/company-smoke.mjs",
    "test:integration": "node --env-file=.env --import tsx --test --test-concurrency=1 tests/integration/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "3.0.3",
    "lucide-react": "^0.468.0",
    "next": "15.5.29",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "embedded-postgres": "^16.14.0-beta.17",
    "postcss": "^8.5.0",
    "prisma": "^6.16.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
